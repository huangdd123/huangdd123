<view class="container">
  <view class="section">
    <view class="title">注册账号</view>
    <view class="subtitle">成为非遗文化的传播者</view>
  </view>

  <view class="section">
    <view class="field">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入姓名" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入手机号" />
    </view>
    <view class="field">
      <text class="label">设置密码</text>
      <input class="input" type="password" placeholder="请设置密码" />
    </view>
    <view class="field">
      <text class="label">申请身份</text>
      <picker class="picker" mode="selector" range="{{roles}}" bindchange="handleRoleChange">
        <view class="picker-value">{{selectedRole}}</view>
      </picker>
    </view>
    <button class="btn-primary">提交注册</button>
  </view>

  <view class="section">
    <view class="title">提示</view>
    <view class="subtitle">游客可直接登录浏览，传承者需补充作品信息。</view>
  </view>
</view>
