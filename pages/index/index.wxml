      <view class="card-meta">
        <text class="tag">点赞 98</text>
        <text class="tag">收藏 53</text>
        <text class="tag">评论 19</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="title">快速入口</view>
    <button class="btn-primary" bindtap="goMain">进入主页</button>
    <button class="btn-ghost" bindtap="goRegister">点击注册</button>
  </view>
</view>
