      </swiper-item>
      <swiper-item>
        <image class="banner-image" src="https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=800&q=80" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>

  <view class="section">
    <view class="title">今日推荐</view>
    <view class="card">
      <view class="card-title">《红色泥塑·少年传承》</view>
      <view class="card-desc">记录传承者以红色故事为题材的泥塑创作过程。</view>
      <view class="card-meta">
        <text class="tag">点赞 120</text>
        <text class="tag">收藏 68</text>
        <text class="tag">评论 24</text>
      </view>
    </view>
    <view class="card">
      <view class="card-title">《灯影戏里的红色记忆》</view>
